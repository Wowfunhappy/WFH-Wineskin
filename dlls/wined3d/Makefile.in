MODULE    = wined3d.dll
UNIXLIB   = wined3d.so
IMPORTLIB = wined3d
IMPORTS   = $(VKD3D_PE_LIBS) opengl32 user32 gdi32 advapi32
EXTRAINCL = $(VKD3D_PE_CFLAGS)
UNIX_CFLAGS = $(VA_CFLAGS)
# UNIX_LIBS = -lwin32u (WINESKIN)
UNIX_LIBS = -lwin32u -framework OpenCL -framework OpenGL

VER_FILEDESCRIPTION_STR = "Wine D3D"

# WINESKIN: compute shaders on OpenCL (cl_compute.c, cl.c on the Unix side); client thread buffer
# maps (map_shadow.c); OpenGL buffer reuse (bo_pool_gl.c); redundant state calls dropped (gl_filter.c);
# GPU copies between texture formats (texture_copy_gl.c) and views that are textures (view_copy_gl.c).
# WINESKIN: BC6H and BC7 decoded on upload (bptc_decompress.c, bcdec.h); buffer views of formats that
# are not buffer texture formats (buffer_convert_gl.c); a frame capture for debugging (frame_dump_gl.c).
SOURCES = \
	frame_dump_gl.c \
	bptc_decompress.c \
	buffer_convert_gl.c \
	texture_copy_gl.c \
	view_copy_gl.c \
	cl.c \
	cl_compute.c \
	bo_pool_gl.c \
	gl_filter.c \
	map_shadow.c \
	adapter_gl.c \
	adapter_vk.c \
	buffer.c \
	context.c \
	context_gl.c \
	context_vk.c \
	cs.c \
	decoder.c \
	device.c \
	directx.c \
	ffp_gl.c \
	ffp_hlsl.c \
	gl_compat.c \
	glsl_shader.c \
	palette.c \
	query.c \
	resource.c \
	resource.rc \
	sampler.c \
	shader.c \
	shader_sm1.c \
	shader_sm4.c \
	shader_spirv.c \
	stateblock.c \
	surface.c \
	swapchain.c \
	texture.c \
	texture_gl.c \
	texture_vk.c \
	utils.c \
	va.c \
	vertexdeclaration.c \
	view.c \
	wined3d_main.c
