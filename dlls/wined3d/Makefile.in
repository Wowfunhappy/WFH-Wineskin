MODULE    = wined3d.dll
UNIXLIB   = wined3d.so
IMPORTLIB = wined3d
IMPORTS   = $(VKD3D_PE_LIBS) opengl32 user32 gdi32 advapi32
EXTRAINCL = $(VKD3D_PE_CFLAGS)
UNIX_CFLAGS = $(VA_CFLAGS)
# UNIX_LIBS = -lwin32u (WINESKIN)
UNIX_LIBS = -lwin32u -framework OpenCL -framework OpenGL

VER_FILEDESCRIPTION_STR = "Wine D3D"

# WINESKIN: compute shaders on OpenCL (cl_compute.c, and cl.c on the Unix side); dynamic buffer
# maps from the client thread (map_shadow.c); reuse of retired OpenGL buffers (bo_pool_gl.c).
SOURCES = \
	cl.c \
	cl_compute.c \
	bo_pool_gl.c \
	map_shadow.c \
	adapter_gl.c \
	adapter_vk.c \
	buffer.c \
	context.c \
	context_gl.c \
	context_vk.c \
	cs.c \
	decoder.c \
	device.c \
	directx.c \
	ffp_gl.c \
	ffp_hlsl.c \
	gl_compat.c \
	glsl_shader.c \
	palette.c \
	query.c \
	resource.c \
	resource.rc \
	sampler.c \
	shader.c \
	shader_sm1.c \
	shader_sm4.c \
	shader_spirv.c \
	stateblock.c \
	surface.c \
	swapchain.c \
	texture.c \
	texture_gl.c \
	texture_vk.c \
	utils.c \
	va.c \
	vertexdeclaration.c \
	view.c \
	wined3d_main.c
