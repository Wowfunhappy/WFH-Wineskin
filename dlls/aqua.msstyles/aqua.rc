"; Toolbar\r\n"
"[Toolbar]\r\n"
"BgType = None\r\n"
"TextColor = 0 0 0\r\n"
"\r\n"
"[Toolbar.Button]\r\n"
"BgType = ImageFile\r\n"
"SizingType = Stretch\r\n"
"SizingMargins = 5, 5, 5, 5\r\n"
"ContentMargins = 0, 0, 0, 0\r\n"
"ImageFile = aqua_toolbar_button.bmp\r\n"
"ImageCount = 8\r\n"
"ImageLayout = Vertical\r\n"
"Transparent = True\r\n"
"\r\n"
"[Toolbar.DropDownButton]\r\n"
"BgType = ImageFile\r\n"
"SizingType = Stretch\r\n"
"SizingMargins = 5, 5, 5, 5\r\n"
"ContentMargins = 0, 0, 0, 0\r\n"
"ImageFile = aqua_toolbar_button.bmp\r\n"
"ImageCount = 8\r\n"
"ImageLayout = Vertical\r\n"
"Transparent = True\r\n"
"\r\n"
"[Toolbar.SplitButton]\r\n"
"BgType = ImageFile\r\n"
"SizingType = Stretch\r\n"
"SizingMargins = 5, 5, 5, 5\r\n"
"ContentMargins = 0, 0, 0, 0\r\n"
"ImageFile = aqua_toolbar_button.bmp\r\n"
"ImageCount = 8\r\n"
"ImageLayout = Vertical\r\n"
"Transparent = True\r\n"
"\r\n"
"[Toolbar.SplitButtonDropDown]\r\n"
"BgType = ImageFile\r\n"
"SizingType = Stretch\r\n"
"SizingMargins = 0, 0, 0, 0\r\n"
"ContentMargins = 0, 0, 1, 0\r\n"
"ImageFile = aqua_empty8.bmp\r\n"
"ImageCount = 8\r\n"
"ImageLayout = Vertical\r\n"
"Transparent = True\r\n"
"GlyphType = ImageGlyph\r\n"
"GlyphTransparent = True\r\n"
"ImageSelectType = Dpi\r\n"
"ImageFile1 = aqua_toolbar_dropdown_glyph_96dpi.bmp\r\n"
"ImageFile2 = aqua_toolbar_dropdown_glyph_120dpi.bmp\r\n"
"ImageFile3 = aqua_toolbar_dropdown_glyph_144dpi.bmp\r\n"
"ImageFile4 = aqua_toolbar_dropdown_glyph_192dpi.bmp\r\n"
"MinDpi1 = 96\r\n"
"MinDpi2 = 120\r\n"
"MinDpi3 = 144\r\n"
"MinDpi4 = 192\r\n"
"\r\n"
"[Toolbar.Separator]\r\n"
"BgType = ImageFile\r\n"
"SizingType = Stretch\r\n"
"SizingMargins = 4, 3, 4, 4\r\n"
"ImageFile = aqua_toolbar_separator.bmp\r\n"
"Transparent = True\r\n"
"\r\n"
"[Toolbar.SeparatorVert]\r\n"
"BgType = ImageFile\r\n"
"SizingType = Stretch\r\n"
"SizingMargins = 4, 4, 4, 3\r\n"
"ImageFile = aqua_toolbar_separator_vert.bmp\r\n"
"Transparent = True\r\n"
"\r\n"
"\r\n"
"; TrackBar\r\n"
"[TrackBar]\r\n"
"BgType = None\r\n"
"\r\n"
"[TrackBar.Track]\r\n"
"BgType = ImageFile\r\n"
"SizingType = Stretch\r\n"
"SizingMargins = 3, 3, 1, 1\r\n"
"ImageFile = aqua_trackbar_track.bmp\r\n"
"Transparent = True\r\n"
"\r\n"
"[TrackBar.TrackVert]\r\n"
"BgType = ImageFile\r\n"
"SizingType = Stretch\r\n"
"SizingMargins = 1, 1, 3, 3\r\n"
"ImageFile = aqua_trackbar_track_vert.bmp\r\n"
"Transparent = True\r\n"
"\r\n"
"[TrackBar.Thumb]\r\n"
