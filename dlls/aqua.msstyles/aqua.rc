"; Spin\r\n"
"[Spin]\r\n"
"BgType = None\r\n"
"\r\n"
"[Spin.Up]\r\n"
"BgType = ImageFile\r\n"
"SizingType = Stretch\r\n"
"SizingMargins = 5, 5, 5, 5\r\n"
"ContentMargins = 0, 0, 0, 0\r\n"
