"ImageLayout = Vertical\r\n"
"\r\n"
"[Edit.EditText(Disabled)]\r\n"
"TextColor = 160 160 160\r\n"
"\r\n"
"[Edit.EditText(CueBanner)]\r\n"
"TextColor = 160 160 160\r\n"
"\r\n"
"\r\n"
"; Header\r\n"
"[Header]\r\n"
"BgType = None\r\n"
"\r\n"
"[Header.HeaderItem]\r\n"
