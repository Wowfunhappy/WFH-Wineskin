#include <winnt.h>

#define IDS_COLOR_DISPLAY_NAME_BLUE      1000
#define IDS_COLOR_DISPLAY_NAME_GRAPHITE  1001
#define IDS_COLOR_TOOLTIP_BLUE           2000
#define IDS_COLOR_TOOLTIP_GRAPHITE       2001
#define IDS_SIZE_DISPLAY_NAME_NORMAL     3000
#define IDS_SIZE_TOOLTIP_NORMAL          4000

LANGUAGE LANG_ENGLISH, SUBLANG_DEFAULT

/* Theme color display names */
STRINGTABLE
{
    IDS_COLOR_DISPLAY_NAME_BLUE     "Blue"
    IDS_COLOR_DISPLAY_NAME_GRAPHITE "Graphite"
}

/* Theme color tooltips */
STRINGTABLE
{
    IDS_COLOR_TOOLTIP_BLUE     "Blue"
    IDS_COLOR_TOOLTIP_GRAPHITE "Graphite"
}

/* Theme size display names */
STRINGTABLE
{
    IDS_SIZE_DISPLAY_NAME_NORMAL "Normal"
}

/* Theme size tooltips */
STRINGTABLE
{
    IDS_SIZE_TOOLTIP_NORMAL "Normal"
}

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

/* Theme version */
1 PACKTHEM_VERSION {0x3}

/* Theme color names */
1 COLORNAMES
{
"Blue\0"
"Graphite\0"
"\0"
}

/* Theme size names */
1 SIZENAMES
{
"NormalSize\0"
"\0"
}

/* Theme ini files, one per color and size */
1 FILERESNAMES
{
"BLUE_INI\0"
"GRAPHITE_INI\0"
"\0"
}

/* Theme definition */
THEMES_INI TEXTFILE
{
"[documentation]\r\n"
"DisplayName = Aqua\r\n"
"ToolTip = Aqua Visual Style\r\n"
}


/* Blue */
BLUE_INI TEXTFILE
{
"[Globals]\r\n"
"EdgeLightColor = 255 255 255\r\n"
"EdgeHighLightColor = 255 255 255\r\n"
"EdgeShadowColor = 190 190 190\r\n"
"EdgeDkShadowColor = 150 150 150\r\n"
"EdgeFillColor = 236 236 236\r\n"
"\r\n"
"[SysMetrics]\r\n"
"ScrollbarWidth = 15\r\n"
"ScrollbarHeight = 15\r\n"
"\r\n"
"; System colours\r\n"
"Scrollbar = 245 245 245\r\n"
"Background = 61 106 154\r\n"
"ActiveCaption = 220 220 220\r\n"
"InactiveCaption = 240 240 240\r\n"
"Menu = 255 255 255\r\n"
"Window = 255 255 255\r\n"
"WindowFrame = 160 160 160\r\n"
"MenuText = 0 0 0\r\n"
"WindowText = 0 0 0\r\n"
"CaptionText = 38 38 38\r\n"
"ActiveBorder = 236 236 236\r\n"
"InactiveBorder = 236 236 236\r\n"
"AppWorkSpace = 178 178 178\r\n"
"Highlight = 56 117 215\r\n"
"HighlightText = 255 255 255\r\n"
"BtnFace = 236 236 236\r\n"
"BtnShadow = 170 170 170\r\n"
"GrayText = 152 152 152\r\n"
"BtnText = 0 0 0\r\n"
"InactiveCaptionText = 158 158 158\r\n"
"BtnHighlight = 255 255 255\r\n"
"DkShadow3d = 140 140 140\r\n"
"Light3d = 245 245 245\r\n"
"InfoText = 0 0 0\r\n"
"InfoBk = 255 255 199\r\n"
"ButtonAlternateFace = 190 190 190\r\n"
"HotTracking = 36 104 210\r\n"
"GradientActiveCaption = 220 220 220\r\n"
"GradientInactiveCaption = 240 240 240\r\n"
"MenuHilight = 64 128 236\r\n"
"MenuBar = 236 236 236\r\n"
"\r\n"
"; Fonts: sizes are in points, 10 points being 13 pixels at 96 DPI\r\n"
"CaptionFont = Lucida Grande, 10\r\n"
"SmallCaptionFont = Lucida Grande, 8\r\n"
"MenuFont = Lucida Grande, 10\r\n"
"StatusFont = Lucida Grande, 9\r\n"
"MsgBoxFont = Lucida Grande, 9\r\n"
"IconTitleFont = Lucida Grande, 9\r\n"
"\r\n"
"FlatMenus = true\r\n"
"\r\n"
"\r\n"
"; Button\r\n"
"[Button.Pushbutton]\r\n"
"BgType = ImageFile\r\n"
"SizingType = Stretch\r\n"
"SizingMargins = 9, 9, 9, 9\r\n"
"ContentMargins = 4, 4, 3, 4\r\n"
"ImageCount = 6\r\n"
"ImageLayout = Vertical\r\n"
"ImageSelectType = Dpi\r\n"
"ImageFile1 = aqua_button_96dpi.bmp\r\n"
"ImageFile2 = aqua_button_120dpi.bmp\r\n"
"ImageFile3 = aqua_button_144dpi.bmp\r\n"
"ImageFile4 = aqua_button_192dpi.bmp\r\n"
"MinDpi1 = 96\r\n"
"MinDpi2 = 120\r\n"
"MinDpi3 = 144\r\n"
"MinDpi4 = 192\r\n"
"Transparent = True\r\n"
"TextColor = 0 0 0\r\n"
"MinSize = 10, 5\r\n"
"\r\n"
"[Button.Pushbutton(Disabled)]\r\n"
"TextColor = 160 160 160\r\n"
"\r\n"
"[Button.Checkbox]\r\n"
"BgType = ImageFile\r\n"
"SizingType = TrueSize\r\n"
"SizingMargins = 0, 0, 0, 0\r\n"
"ContentMargins = 0, 0, 0, 0\r\n"
"ImageCount = 20\r\n"
"ImageLayout = Vertical\r\n"
"ImageSelectType = Dpi\r\n"
"TrueSizeScalingType = Dpi\r\n"
"UniformSizing = True\r\n"
"MirrorImage = False\r\n"
"Transparent = True\r\n"
"ImageFile1 = aqua_checkbox_96dpi.bmp\r\n"
"ImageFile2 = aqua_checkbox_120dpi.bmp\r\n"
"ImageFile3 = aqua_checkbox_144dpi.bmp\r\n"
"ImageFile4 = aqua_checkbox_192dpi.bmp\r\n"
"MinDpi1 = 96\r\n"
"MinDpi2 = 120\r\n"
"MinDpi3 = 144\r\n"
"MinDpi4 = 192\r\n"
"\r\n"
"[Button.Checkbox(Uncheckeddisabled)]\r\n"
"TextColor = 160 160 160\r\n"
"\r\n"
"[Button.Checkbox(Checkeddisabled)]\r\n"
"TextColor = 160 160 160\r\n"
"\r\n"
"[Button.Checkbox(Mixeddisabled)]\r\n"
"TextColor = 160 160 160\r\n"
"\r\n"
"[Button.Checkbox(ImplicitDisabled)]\r\n"
"TextColor = 160 160 160\r\n"
"\r\n"
"[Button.Checkbox(ExcludedDisabled)]\r\n"
"TextColor = 160 160 160\r\n"
"\r\n"
"[Button.Radiobutton]\r\n"
"BgType = ImageFile\r\n"
"SizingType = TrueSize\r\n"
"SizingMargins = 0, 0, 0, 0\r\n"
"ContentMargins = 0, 0, 0, 0\r\n"
"ImageCount = 8\r\n"
"ImageLayout = Vertical\r\n"
"ImageSelectType = Dpi\r\n"
"TrueSizeScalingType = Dpi\r\n"
"UniformSizing = True\r\n"
"Transparent = True\r\n"
"ImageFile1 = aqua_radiobutton_96dpi.bmp\r\n"
"ImageFile2 = aqua_radiobutton_120dpi.bmp\r\n"
"ImageFile3 = aqua_radiobutton_144dpi.bmp\r\n"
"ImageFile4 = aqua_radiobutton_192dpi.bmp\r\n"
"MinDpi1 = 96\r\n"
"MinDpi2 = 120\r\n"
"MinDpi3 = 144\r\n"
"MinDpi4 = 192\r\n"
"\r\n"
"[Button.Radiobutton(Uncheckeddisabled)]\r\n"
"TextColor = 160 160 160\r\n"
"\r\n"
"[Button.Radiobutton(Checkeddisabled)]\r\n"
"TextColor = 160 160 160\r\n"
"\r\n"
"[Button.Groupbox]\r\n"
"BgType = ImageFile\r\n"
"SizingType = Stretch\r\n"
"SizingMargins = 5, 5, 5, 5\r\n"
"ImageFile = aqua_groupbox.bmp\r\n"
"BorderOnly = True\r\n"
"Transparent = True\r\n"
"TextColor = 0 0 0\r\n"
"\r\n"
"[Button.Groupbox(Disabled)]\r\n"
"TextColor = 160 160 160\r\n"
"\r\n"
"\r\n"
"; ComboBox\r\n"
"[ComboBox]\r\n"
