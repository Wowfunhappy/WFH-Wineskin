"MinDpi4 = 192\r\n"
"\r\n"
"[ComboBox.CueBanner]\r\n"
"TextColor = 160 160 160\r\n"
"\r\n"
"\r\n"
"; Edit\r\n"
"[Edit]\r\n"
"BgType = ImageFile\r\n"
"SizingType = Stretch\r\n"
"SizingMargins = 2, 2, 2, 2\r\n"
"ContentMargins = 2, 2, 2, 2\r\n"
